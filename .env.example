# Homey Intelligence — Environment Variables
# Copy this to .env and fill in your values

# ── Required for LLM responses ────────────────────────────────────────────────
# Free key from https://console.groq.com
# All tests pass WITHOUT this key — LLM path degrades to retrieval-only
GROQ_API_KEY=your_groq_api_key_here

# ── Optional: corpus location ─────────────────────────────────────────────────
# If set, retrieval_gov.py loads documents from this directory
# Each .txt file must have a sidecar .json metadata file
# See agents/retrieval_gov.py:load_corpus_from_disk() for format
HOMEY_CORPUS_DIR=

# ── Optional: feature flags ───────────────────────────────────────────────────
# Enable semantic guard (Layer 3) — requires model call
HOMEY_SEMANTIC_GUARD=false

# Enable retrieval layer (Slice 2)
HOMEY_RETRIEVAL=false

# Enable fit scoring (Slice 3)
HOMEY_FIT=false

# ── Production (set by Nikunj's infrastructure) ───────────────────────────────
# S3 bucket for document corpus
# HOMEY_S3_BUCKET=vryfid-docs
# HOMEY_S3_PREFIX=homey-corpus/

# Tenant ID for event scoping
# HOMEY_TENANT_ID=vryfid
